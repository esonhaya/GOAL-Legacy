{
    "name": "goal-legacy/core",
    "description": "GOAL: Legacy reusable simulation framework foundation",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "../BoardPrep-Doctor",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "esonhaya/haya-doctor": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Goal\\Legacy\\Core\\": "game/core/",
            "Goal\\Legacy\\Devtools\\": "game/devtools/",
            "Goal\\Legacy\\Modules\\Nation\\": "game/modules/nation/",
            "Goal\\Legacy\\Modules\\World\\": "game/modules/world/",
            "Goal\\Legacy\\Modules\\Competition\\": "game/modules/competition/",
            "Goal\\Legacy\\Modules\\Club\\": "game/modules/club/",
            "Goal\\Legacy\\Modules\\Player\\": "game/modules/player/",
            "Goal\\Legacy\\": "game/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goal\\Legacy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:core": "@php vendor/bin/phpunit --testsuite core",
        "doctor": "@php game/devtools/console.php doctor",
        "core:self-check": "@php game/devtools/console.php core:self-check",
        "time:self-check": "@php game/devtools/console.php time:self-check",
        "persistence:self-check": "@php game/devtools/console.php persistence:self-check",
        "content:list": "@php game/devtools/console.php content:list",
        "nation:list": "@php game/devtools/console.php nation:list",
        "nation:self-check": "@php game/devtools/console.php nation:self-check",
        "competition:list": "@php game/devtools/console.php competition:list",
        "club:list": "@php game/devtools/console.php club:list",
        "player:create-demo": "@php game/devtools/console.php player:create-demo",
        "transfer:self-check": "@php game/devtools/console.php transfer:self-check",
        "world:self-check": "@php game/devtools/console.php world:self-check",
        "modules:list": "@php game/devtools/console.php modules:list",
        "config:inspect": "@php game/devtools/console.php config:inspect",
        "logs:recent": "@php game/devtools/console.php logs:recent"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
